# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Comma-separated CORS allowlist; defaults to APP_URL
CORS_ORIGINS=http://localhost:3000

# ── Security (CHANGE THESE IN PRODUCTION) ───────────────
JWT_SECRET=change-me-to-a-long-random-string
CSRF_SECRET=change-me-too-32-chars-minimum

# ── Database (Supabase pooled connection string works) ──
# Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:password@localhost:5432/watchrewards
DATABASE_SSL=false          # true for Supabase / hosted PG
# DB_MODE=json              # force the local JSON store (dev/testing only)
# DB_DIR=                   # data dir for the JSON store (default ./data)

# ── Admin bootstrap (used by `npm run seed`) ────────────
ADMIN_EMAIL=admin@watchrewards.app
ADMIN_PASSWORD=Admin@1234
ADMIN_PHONE=0712345678

# ── Platform rules (operator-editable in the admin console) ─
WATCH_DAILY_LIMIT=5          # videos a user may be rewarded for per day
WATCH_REQUIRED_PCT=0.9       # share of a video that must actually be watched
WATCH_MIN_SECONDS=10
# WATCH_MAX_SESSION_SECONDS=3600   # hard cap on a single watch session
REFERRAL_REWARD=20           # paid once, when a referred user completes a watch task
MIN_WITHDRAWAL=150
WITHDRAWAL_FEE_PCT=2
WITHDRAWAL_DAILY_LIMIT=70000
MIN_DEPOSIT=10
MAX_DEPOSIT=150000
EXPECTED_PROCESSING="Within 24 hours"
SUPPORT_EMAIL=support@watchrewards.app

# ── Payment provider (section 28) ─────────────────────────
# provider: mpesa (live Daraja) — anything else is a sandbox and is refused in production
PAYMENT_PROVIDER=mpesa
# mode: live | sandbox. In sandbox no real STK/B2C requests are sent and the UI
# says so. Never set sandbox in production.
PAYMENT_MODE=sandbox
PAYMENT_ACCOUNT_REF=WATCHREWARDS
PAYMENT_CURRENCY=KES

# ── M-Pesa collections (STK Push) ────────────────────────
# Leave MPESA_APP_KEY empty only for local development (sandbox provider).
MPESA_ENV=sandbox                  # sandbox | production
MPESA_APP_KEY=                     # Consumer key
MPESA_APP_SECRET=                  # Consumer secret
MPESA_SHORTCODE=174379             # Paybill / Till
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
MPESA_BASE_URL=                    # override for tunnels, e.g. https://abc.ngrok.io

# ── M-Pesa payouts (B2C) — required before live withdrawals ─
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_RESULT_URL=https://your-domain.com/api/mpesa/callback
MPESA_B2C_TIMEOUT_URL=https://your-domain.com/api/mpesa/callback

# ── Email (SMTP). Console logger if SMTP_HOST empty ──────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WATCHREWARDS <no-reply@watchrewards.app>"
