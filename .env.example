# ============================================================================
# TaskCash Pro — environment variables
#
# Copy to `.env.local` for development and set these in your hosting provider's
# environment settings for production. NEVER commit real values.
#
# Anything prefixed with NEXT_PUBLIC_ is embedded in browser JavaScript.
# Never put a secret behind that prefix.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase (database, auth, storage)
#
# Use a DEDICATED Supabase project for TaskCash Pro. Do not point this at a
# database that holds another application's tables.
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). SERVER ONLY. Bypasses RLS — never expose it to
# the browser, never log it, never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Legacy alias for the same key, still honoured for backward compatibility.
# Set either this or SUPABASE_SECRET_KEY; SUPABASE_SECRET_KEY wins if both are set.
# SUPABASE_SERVICE_ROLE_KEY=
# Optional. Only needed to verify a Supabase-issued JWT server-side:
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# ---------------------------------------------------------------------------
# Database (migration workflow only — the running app never reads this)
#
# Supabase → Connect → Connection String → Session Pooler → URI.
# The SESSION pooler (port 5432) is required: the transaction pooler (6543)
# cannot run these migrations, and `npm run preflight` rejects it.
#
# Percent-encode reserved characters in the password:
#   %  -> %25      @ -> %40      : -> %3A      / -> %2F
#   ?  -> %3F      # -> %23      & -> %26      [ -> %5B      ] -> %5D
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Tooling only — `npm run db:push-sql`
#
# When DATABASE_URL cannot be obtained, `db:push-sql` can still apply the SQL by
# sending it to the Management API over HTTPS: no clipboard, no browser, no
# database password. It needs a personal access token:
#
#   https://supabase.com/dashboard/account/tokens   (permission: database_write)
#
# Set it with `npm run env:set` (masked). NOTHING in src/ reads this variable —
# it is not part of the app's configuration and the app runs fine without it.
# Unlike a project API key it is ACCOUNT-WIDE (it can create and delete
# projects), so delete the token in the dashboard when you are finished.
#
# The same token also drives `npm run smtp:configure` (permission:
# auth_config_write) and `npm run db:push-sql`. It is never an application
# credential and must not be used as one.
# ---------------------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL of the deployment, e.g. https://taskcashpro.com
# Local development in this workspace runs on port 4177.
APP_URL=http://localhost:4177
NEXT_PUBLIC_APP_URL=http://localhost:4177

# At least 32 characters. Keys the HMAC hashes of IP/device identifiers and
# signs short-lived approval tokens. Rotating it invalidates old hashes.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Protects the scheduled reconciliation endpoint. At least 16 characters.
CRON_SECRET=

# Optional: the address you will promote to SUPER_ADMIN after provisioning.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Email delivery — Supabase Auth SMTP
#
# These configure the SUPABASE PROJECT, not this application: Supabase Auth is
# what sends confirmation and password-reset emails. Nothing in src/ reads them,
# so they are server-side tooling, and applying them is a separate step:
#
#     npm run smtp:configure            # pushes them to the project
#     npm run smtp:configure -- --check # shows what the project is actually using
#
# WHY THIS MATTERS: with no custom SMTP, Supabase falls back to its own email
# service, which allows roughly TWO AUTH EMAILS PER HOUR. Registration then fails
# at the third signup with "Too many sign-up attempts", which looks like an
# application bug and is not one. `npm run preflight -- --production` fails
# while these are unset.
#
# Use the SMTP credentials from any transactional provider — Resend, Postmark,
# Brevo, Mailgun, Amazon SES, SendGrid. Nothing here is vendor-specific.
#
#   Port 587 = STARTTLS (the usual choice)   Port 465 = implicit TLS
#   Port 25 is rejected by preflight: widely blocked and hardest rate-limited.
#
# SMTP_FROM_EMAIL must be an address on a domain you have VERIFIED with the
# provider. Sending from an unverified domain is rejected, or lands in spam.
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=TaskCash Pro
# The project's own cap on auth emails per hour. 2 is a development placeholder;
# raise it to something your provider allows once real SMTP is wired.
# SMTP_RATE_LIMIT_EMAILS=30

# ---------------------------------------------------------------------------
# SasaPay (payments) — retained, NOT the active provider by default
#
# Use the values from YOUR merchant account. Confirm SASAPAY_API_URL against
# the current SasaPay documentation / merchant dashboard before going live —
# do not leave a sandbox URL in production.
#
# Sandbox base:    https://sandbox.sasapay.app/api/v1
# Production base: confirm with SasaPay for your merchant account
#
# Until all four of the below are set, nothing can be paid out: approving a
# withdrawal records the approval and keeps the funds held. See the note on
# SASAPAY_SIMULATOR below.
#
# To use SasaPay instead of M-Pesa, set PAYMENTS_PROVIDER=sasapay below.
# ---------------------------------------------------------------------------
SASAPAY_CLIENT_ID=
SASAPAY_CLIENT_SECRET=
SASAPAY_MERCHANT_CODE=
SASAPAY_API_URL=
SASAPAY_CALLBACK_URL=https://your-domain.example/api/payments/sasapay/callback
SASAPAY_ENV=sandbox
SASAPAY_TIMEOUT_MS=20000

# Network / channel codes are market-specific and come from SasaPay onboarding.
SASAPAY_DEFAULT_NETWORK_CODE=SASAFA
SASAPAY_DEFAULT_CHANNEL_CODE=0

# Callback hardening. Set at least one in production.
#  - SASAPAY_CALLBACK_SECRET: compared against an `x-sasapay-signature` HMAC of
#    the raw body, or a `token` query parameter on the callback URL.
#  - SASAPAY_CALLBACK_IPS: comma-separated allowlist of provider source IPs.
#
# Note: these narrow the attack surface, but the security boundary is the
# mandatory transaction-status re-check before anything is credited or paid.
SASAPAY_CALLBACK_SECRET=
SASAPAY_CALLBACK_IPS=

# ---------------------------------------------------------------------------
# Development only
#
# SASAPAY_SIMULATOR=1 substitutes the *provider's* HTTP responses so the deposit
# pipeline can be exercised without live credentials. It is ignored under
# NODE_ENV=production, never writes to the database, and tags affected records
# as SIMULATED.
#
# It does NOT unlock payouts. A simulated disbursement would record a completed
# payout that never happened, and once it is in the ledger a fake payout is
# indistinguishable from a real one. So with the simulator on, approving a
# withdrawal still records only the approval and keeps the funds held — the
# admin screen says so, and the approval response reports paymentInitiated:false.
#
# Outcome control, encoded in the payment reference:
#   ...-FAIL     the transaction fails
#   ...-CANCEL   the customer cancels
#   ...-PENDING  stays pending (tests reconciliation)
#   anything else succeeds
# ---------------------------------------------------------------------------
SASAPAY_SIMULATOR=

# ===========================================================================
# PAYMENTS — WHICH PROVIDER
# ===========================================================================
#
# M-Pesa (Safaricom Daraja) is the provider this platform uses. The SasaPay
# configuration above is retained and still works; select it by setting this to
# `sasapay`. Default when unset: mpesa.
# ---------------------------------------------------------------------------
PAYMENTS_PROVIDER=mpesa

# ===========================================================================
# M-PESA (SAFARICOM DARAJA)
# ===========================================================================
#
# Everything below comes from the Daraja portal:
#   https://developer.safaricom.co.ke  →  your app  →  keys and test credentials
#
# MPESA_ENV selects the host: https://sandbox.safaricom.co.ke or
# https://api.safaricom.co.ke. Daraja's endpoints are fixed, so there is nothing
# else to configure — a typo'd hostname is indistinguishable from a network
# failure at the call site. A production build REFUSES to call the sandbox host.
#
# MPESA_BASE_URL below exists because configuration templates carry it. It is an
# ASSERTION, not an override: it must name one of those two hosts AND agree with
# MPESA_ENV, or the app refuses to start and names the variable to change. It can
# never point at a third host, because that is where the Consumer Secret would be
# sent. Leave it commented out unless a template forces you to set it.
#
# None of this is required to run the application. Left empty, deposits and
# payouts are disabled and the routes say so plainly. Nothing is simulated:
# unlike SasaPay there is no M-Pesa simulator, because a fabricated payout is
# indistinguishable from a real one once it is in the ledger.
#
# Live money also requires a merchant account: to SEND money you need a B2C
# (Bulk Disbursement) shortcode, which Safaricom grants separately from the
# paybill/till that collects.

MPESA_ENV=sandbox

# Optional, and normally omitted. Uncomment only to assert the host for the
# environment above; it must match MPESA_ENV exactly or startup fails. Keeping it
# commented is what makes switching MPESA_ENV to `production` safe — there is no
# stale URL left behind to disagree with it.
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# --- Collections (deposits) — STK Push --------------------------------------
# Required before any user can deposit.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be https — Safaricom does not call back over http. Register this exact
# URL on the Daraja app. Safaricom cannot reach localhost, so a sandbox test
# needs a public HTTPS tunnel in front of the dev server.
MPESA_CALLBACK_URL=https://your-domain.example/api/payments/mpesa/callback
# CustomerPayBillOnline for a paybill, CustomerBuyGoodsOnline for a till.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# --- Sandbox testing only ---------------------------------------------------
#
# For a local test against Daraja's sandbox, Safaricom publishes the values:
# shortcode 174379, a sandbox passkey from your app's page, and the test MSISDN
# 254708374149. The sandbox does not deliver push notifications to handsets and
# moves no money. Set MPESA_ENV=sandbox and PAYMENTS_PROVIDER=mpesa (an explicit
# provider is required — the fallback prefers PayHero whenever its credentials
# exist), then run `npm run check:daraja` before the first test deposit.
#
# A test deposit at KES 50 would otherwise be refused by the live KES 800 floor.
# Rather than editing `currencies.min_deposit` — live payment configuration that
# would then have to be put back — set this, which lowers the floor ONLY in a
# development process pointed at the sandbox, and only ever downwards:
#
# MPESA_SANDBOX_MIN_DEPOSIT=50
#
# The deposit page reads its bounds from the same function the server enforces
# them with, so the advertised minimum and the quick-pick chips follow this
# value. Remove or comment it out to restore the live floor.
#
# While MPESA_ENV=sandbox, `npm run deploy:env` REFUSES to run against
# production: a sandbox-configured tree must not be able to write that out as
# the live M-Pesa environment, and sandbox credentials must never reach a
# deployed environment. The refusal names the variable responsible. Point the
# local environment back at production before deploying, or acknowledge it
# deliberately with --allow-sandbox-mpesa-credentials.

# --- Payouts (withdrawals) — B2C --------------------------------------------
# Required before an approved withdrawal can actually be paid. A separate
# credential set from the collection block on purpose: taking money in and
# sending money out are configured independently, and conflating them hides a
# missing B2C account until an administrator approves a payout.
MPESA_B2C_INITIATOR_NAME=
# The initiator password, RSA-encrypted with Safaricom's public certificate. The
# Daraja portal will encrypt it for you; the certificate is not committed here.
MPESA_B2C_SECURITY_CREDENTIAL=
# Defaults to MPESA_SHORTCODE when unset. Paying out from a different shortcode
# requires Safaricom's "one account" arrangement.
MPESA_B2C_SHORTCODE=
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_RESULT_URL=https://your-domain.example/api/payments/mpesa/b2c/result
MPESA_B2C_QUEUE_TIMEOUT_URL=https://your-domain.example/api/payments/mpesa/b2c/timeout

# --- Callback authenticity (recommended in production, enforced by preflight) ---
#
# Safaricom does not sign callbacks, so a callback on its own is a claim from
# the internet. Set ONE of these:
#
#  - MPESA_CALLBACK_SECRET: a shared secret. Register the callback URLs with
#    ?token=<secret> appended, and/or send an `x-mpesa-signature` HMAC-SHA256 of
#    the raw body. A mismatch is rejected with 401.
#  - MPESA_CALLBACK_IPS: comma-separated source addresses to allow.
#
# With neither set a callback is recorded as UNVERIFIED. Deposits are still only
# credited after an independent STK status query confirms them, so a forged
# collection callback cannot create money. A payout has no second source: an
# unauthenticated B2C result is NOT acted on, and the withdrawal waits for an
# operator. `npm run preflight --production` fails on this.
MPESA_CALLBACK_SECRET=
MPESA_CALLBACK_IPS=

# Request timeout in milliseconds for every Daraja call.
MPESA_TIMEOUT_MS=20000

# ===========================================================================
# PAYHERO (Kenya — Lipa na M-Pesa collections, and payouts)
# ===========================================================================
#
# This is the provider production actually runs. Select it with
# PAYMENTS_PROVIDER=payhero. PayHero authenticates with HTTP **Basic** — an API
# username and password issued in the dashboard at https://app.payhero.co.ke —
# so there is no token endpoint and nothing to refresh.
#
# PAYHERO_CHANNEL_ID is the CHANNEL id from Payment Channels → My Payment
# Channels. It is NOT the account id and NOT a till/paybill number: the channel
# id routes the STK push, and using the account id instead is refused by the
# provider rather than silently misrouted.
#
# Left empty, deposits and payouts are disabled and the routes say so plainly.
# Nothing is simulated on this provider.
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=

# Optional. Defaults to https://backend.payhero.co.ke/api/v2. Must be https and
# must be a payhero.co.ke host — the API password is sent there on every request,
# so a third-party host is refused at startup rather than trusted.
# PAYHERO_API_URL=https://backend.payhero.co.ke/api/v2

# Must be https and publicly reachable, or every payment silently never settles.
# Defaults to `${APP_URL}/api/payments/payhero/callback`.
PAYHERO_CALLBACK_URL=https://your-domain.example/api/payments/payhero/callback

# --- Callback authenticity (recommended in production) ----------------------
# PayHero does not sign callbacks, so set ONE of these. Deposits are only
# credited after an independent transaction-status check regardless, so a forged
# collection callback cannot create money.
PAYHERO_CALLBACK_SECRET=
PAYHERO_CALLBACK_IPS=

# Request timeout in milliseconds for every PayHero call.
PAYHERO_TIMEOUT_MS=20000
# Network code PayHero pays out on when a withdrawal does not name one.
PAYHERO_DEFAULT_NETWORK_CODE=SASAFA

# --- EGRESS: the collection endpoint is rate-limited per SOURCE IP ----------
#
# `POST /payments` answers HTTP 417 `rate limit exceeded: request throttled`
# when the calling address has spent its allowance, and the refusal happens
# BEFORE any transaction exists — nothing is charged and no STK reaches the
# customer. Because the limit is keyed to the source address, the egress IP is
# part of this configuration.
#
# Hosting providers that use shared, dynamic egress addresses (including
# Vercel's default) put every tenant behind the same allowance, so requests can
# be throttled by traffic that is not ours. A deployment that must collect
# payments needs an egress address this merchant controls.
#
# Run `npm run check:egress` to report the outbound address the provider sees
# and whether it accepts our credentials from there. It is read-only: it never
# creates a payment.
#
# When a proxy is provisioned, Node 24 (which Vercel runs) can route outbound
# fetches through it with the standard variables below. NOTE the scoping caveat:
# NODE_USE_ENV_PROXY applies to EVERY outbound fetch, so anything that must stay
# direct (NO_PROXY) has to be listed explicitly.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=
# NO_PROXY=
