# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# Next.js
/.next/
/out/
next-env.d.ts

# Production
/build

# Local env files — never commit real credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# Testing
/coverage

# Misc
.DS_Store
*.pem
*.tsbuildinfo

# Generated by `npm run db:bundle` from supabase/migrations/. Regenerate, do not edit.
supabase/apply-all.sql
supabase/reinit.sql
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local development tooling: probe scripts, the run doc, logs, and test
# accounts. Excluded deliberately — several probe scripts carry a test account's
# password as a fallback, and git history is forever. Nothing here is needed to
# build or run the application.
.freebuff/

.vercel
.env*

# The template is the one exception: it documents every variable this project
# reads and holds no values, so it is the only env file that belongs in git.
!.env.example
