    "test:money": "node scripts/run-money-tests.mjs",
    "test:money:local": "node scripts/run-money-tests.mjs --mode=local",
    "test:money:transaction": "node scripts/run-money-tests.mjs --mode=transaction",
    "env:set": "node scripts/set-env.mjs",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "test:e2e": "node scripts/smoke-e2e.mjs",
    "verify:remote": "node scripts/verify-remote.mjs",
